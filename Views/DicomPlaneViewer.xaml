<UserControl
    x:Class="Views.DicomPlaneViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:converters="clr-namespace:Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:openTK="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
    xmlns:viewmodel="clr-namespace:ViewModels;assembly=ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodel:DicomViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:VisibilityConverter x:Key="boolToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
        <openTK:GLWpfControl
            x:Name="openTkControl"
            Width="{Binding DisplaySize.XPixels}"
            Height="{Binding DisplaySize.YPixels}"
            d:Height="256"
            d:Width="256"
            Render="OpenTkControl_Render" />
        <StackPanel
            Width="240"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <Label Content="{Binding DisplayedPlane}" />
            <Label Content="{Binding CurrentSpaceSlice}" ContentStringFormat="Space position (depth) = {0}" />
            <Slider
                Maximum="{Binding NumberOfSpacePositions}"
                Minimum="1"
                TickFrequency="1"
                TickPlacement="BottomRight"
                Value="{Binding CurrentSpaceSlice}" />
            <CheckBox Content="Apply LUT GE-Rainbow" IsChecked="{Binding UseLUT}" />
            <CheckBox Content="Show hisogram" IsChecked="{Binding IsHistogramShown}" />
        </StackPanel>

        <ScottPlot:WpfPlot
            x:Name="histogramPlot"
            Width="200"
            Height="200"
            Visibility="{Binding IsHistogramShown, Converter={StaticResource boolToVisibilityConverter}}" />

    </StackPanel>
</UserControl>